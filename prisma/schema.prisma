datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   // "Manager" | "Staff"
  createdAt DateTime @default(now())
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  sku            String          @unique
  category       String
  unitOfMeasure  String
  initialStock   Int             @default(0)
  createdAt      DateTime        @default(now())
  inventoryLines InventoryLine[]
  receiptLines   ReceiptLine[]
  deliveryLines  DeliveryLine[]
  transferLines  TransferLine[]
  adjustments    Adjustment[]
}

model Warehouse {
  id        Int        @id @default(autoincrement())
  name      String
  location  String
  locations Location[]
}

model Location {
  id             Int             @id @default(autoincrement())
  name           String
  warehouseId    Int
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  inventoryLines InventoryLine[]
  fromTransfers  TransferLine[]  @relation("FromLocation")
  toTransfers    TransferLine[]  @relation("ToLocation")
  adjustments    Adjustment[]
}

model InventoryLine {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Int      @default(0)
  
  @@unique([productId, locationId])
}

model Receipt {
  id         Int           @id @default(autoincrement())
  supplier   String
  status     String        @default("Draft") // Draft, Ready, Done, Canceled
  createdAt  DateTime      @default(now())
  lines      ReceiptLine[]
}

model ReceiptLine {
  id         Int      @id @default(autoincrement())
  receiptId  Int
  receipt    Receipt  @relation(fields: [receiptId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
}

model Delivery {
  id         Int            @id @default(autoincrement())
  customer   String
  status     String         @default("Draft")
  createdAt  DateTime       @default(now())
  lines      DeliveryLine[]
}

model DeliveryLine {
  id         Int      @id @default(autoincrement())
  deliveryId Int
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
}

model Transfer {
  id         Int            @id @default(autoincrement())
  status     String         @default("Draft")
  createdAt  DateTime       @default(now())
  lines      TransferLine[]
}

model TransferLine {
  id             Int      @id @default(autoincrement())
  transferId     Int
  transfer       Transfer @relation(fields: [transferId], references: [id])
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  fromLocationId Int
  fromLocation   Location @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   Int
  toLocation     Location @relation("ToLocation", fields: [toLocationId], references: [id])
  quantity       Int
}

model Adjustment {
  id             Int      @id @default(autoincrement())
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  locationId     Int
  location       Location @relation(fields: [locationId], references: [id])
  countedQty     Int
  difference     Int
  status         String   @default("Done")
  createdAt      DateTime @default(now())
}
